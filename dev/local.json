{
  "$schema": "../types/integraal.schema.json",
  "scripts": {
    "bucket": "scripts"
  },
  "stores": {
    "In": {
      "type": "s3",
      "bucket": "data-in",
      "prefix": "tenants/"
    },
    "Out": {
      "type": "s3",
      "bucket": "data-out",
      "prefix": "tenants/"
    },
    "Temp": {
      "type": "s3",
      "bucket": "data-temp",
      "prefix": "tenants/"
    }
  },
  "db": {
    "table": "integraal"
  },
  "server": {
    "port": 8080
  },
  "log": "info",
  "flow_logs": {
    "bucket": "flow-logs"
  },
  "local_api": {
    "port": 9091
  },
  "queue": {
    "url": "http://localhost:5070/123456789012/integraal-jobs.fifo"
  }
}
